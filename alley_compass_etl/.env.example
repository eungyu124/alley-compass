# 서울 열린데이터광장 Open API 인증키
SEOUL_API_KEY=YOUR_SEOUL_OPEN_API_KEY

# Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 서버 전용 키.
# 새 Supabase 프로젝트의 secret key를 사용하세요.
# 절대로 React/Vite 프론트엔드에 넣거나 Git에 commit하지 마세요.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# 구형 프로젝트에서 service_role key를 사용하는 경우에는
# 위 SUPABASE_SECRET_KEY 대신 아래 변수를 사용할 수도 있습니다.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Anthropic API 키 (Recommendation/Risk/Verification Agent, narrative_agents.py / pipeline.py)
# console.anthropic.com 에서 발급. Claude Code 로그인과는 별개입니다.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
